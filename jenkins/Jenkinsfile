// ============================================================
// Jenkinsfile — Multi-Workspace Databricks Pipeline
// ============================================================

pipeline {

    agent any

    parameters {
        string(name: 'GROUP_ID',   defaultValue: '', description: 'e.g. FINANCE_MEDALLION_L0')
        string(name: 'BUNDLE_TAG', defaultValue: '', description: 'Release tag e.g. v1.0.0')
        string(name: 'VERSION',    defaultValue: '1.0', description: 'Pipeline version')
        booleanParam(name: 'SYNC_GIT',            defaultValue: true,  description: 'Sync GitHub repo')
        booleanParam(name: 'SYNC_TABLES_TO_GITHUB', defaultValue: true, description: 'Push SQL to META_STORE_SQL_SCRIPTS/')
        booleanParam(name: 'CREATE_JOBS',          defaultValue: true,  description: 'Create/verify Databricks jobs or DLT pipelines')
        booleanParam(name: 'WAIT_FOR_COMPLETION',  defaultValue: true,  description: 'Wait for job completion')
    }

    environment {
        GITHUB_REPO          = 'https://github.com/ID-KARTHIKEYAN/DATA_INTEGRATION.git'
        GITHUB_API           = 'https://api.github.com'
        GITHUB_OWNER         = 'ID-KARTHIKEYAN'
        GITHUB_REPO_NAME     = 'DATA_INTEGRATION'
        GITHUB_BRANCH        = 'main'
        GITHUB_CREDENTIAL_ID = 'GITHUB_TOKEN_SECRET'
        SQL_SCRIPTS_FOLDER   = 'META_STORE_SQL_SCRIPTS'
        POLL_INTERVAL        = '15'
        MAX_WAIT_SECS        = '1800'
    }

    stages {

        // ── STAGE 1 : VALIDATE ───────────────────────────────
        stage('Validate') {
            steps {
                script {
                    if (!params.GROUP_ID?.trim()) error "GROUP_ID required"
                    def gid = params.GROUP_ID.trim().toUpperCase()
                    def layer = gid.endsWith('_L0') ? 'L0' : gid.endsWith('_L1') ? 'L1' : gid.endsWith('_L2') ? 'L2' : 'ALL'
                    def ts    = new Date().format('yyyy-MM-dd HH:mm')
                    def tag   = params.BUNDLE_TAG?.trim() ?: 'untagged'
                    env.DETECTED_LAYER = layer
                    env.DEPLOY_TS      = ts
                    env.BUNDLE_INFO    = "[v${params.VERSION}][${tag}] ${ts} | ${layer} | ${env.GITHUB_BRANCH}"
                    echo "GROUP_ID=${gid} | LAYER=${layer} | BUNDLE=${tag} | ${ts}"
                }
            }
        }

        // ── STAGE 2 : CHECKOUT ──────────────────────────────
        stage('Checkout') {
            steps {
                checkout([$class:'GitSCM', branches:[[name:"*/${env.GITHUB_BRANCH}"]], userRemoteConfigs:[[url:env.GITHUB_REPO]]])
                echo "Checked out ${env.GITHUB_BRANCH}"
            }
        }

        // ── STAGE 3 : LOAD REGISTRY (auto-detects workspace) ──
        stage('Load Registry') {
            steps {
                script {
                    def buildUser = currentBuild
                        .getBuildCauses('hudson.model.Cause$UserIdCause')
                        .collect { it?.userId }
                        .find { it }
                        ?: 'admin'

                    echo "Build user : ${buildUser}"

                    def wsRaw = readFile('workspaces.json')
                    def reg   = readJSON text: wsRaw

                    def sel = reg.workspaces.findAll { ws ->
                        ws.is_active == true && ws.jenkins_user == buildUser
                    }

                    if (sel.isEmpty()) {
                        echo "No mapping for '${buildUser}' — admin mode: all active workspaces"
                        sel = reg.workspaces.findAll { it.is_active == true }
                    }

                    if (sel.isEmpty()) error "No active workspaces in workspaces.json"

                    env.SELECTED_WORKSPACES = writeJSON(returnText: true, json: sel)
                    sel.each { echo "  -> ${it.name} (${it.workspace_url})" }
                }
            }
        }

        // ── STAGE 4 : SYNC GIT ──────────────────────────────
        stage('Sync Git') {
            when { expression { params.SYNC_GIT } }
            steps {
                script {
                    def wsList = readJSON text: env.SELECTED_WORKSPACES
                    wsList.each { ws ->
                        withCredentials([string(credentialsId: ws.credential_id, variable: 'DB_TOKEN')]) {
                            def r    = readJSON text: sh(returnStdout:true, script:"curl -s '${ws.workspace_url}/api/2.0/repos' -H 'Authorization: Bearer ${DB_TOKEN}'").trim()
                            def repo = r.repos?.find { it.path == ws.github_repo_path }
                            if (!repo) { echo "  ${ws.name}: repo not found — skipping"; return }
                            def code = sh(returnStdout:true, script:"""
                                curl -s -w "\\n%{http_code}" -X PATCH '${ws.workspace_url}/api/2.0/repos/${repo.id}' \\
                                -H 'Authorization: Bearer ${DB_TOKEN}' -H 'Content-Type: application/json' \\
                                -d '{"branch":"${env.GITHUB_BRANCH}"}'
                            """).trim().split('\n')[-1]
                            echo "  ${ws.name}: sync HTTP ${code}"
                        }
                    }
                }
            }
        }

        // ── STAGE 4.5 : SYNC TABLES → GITHUB ────────────────
        stage('Sync Tables to GitHub') {
            when { expression { params.SYNC_TABLES_TO_GITHUB } }
            steps {
                script {
                    def wsList   = readJSON text: env.SELECTED_WORKSPACES
                    def groupId  = params.GROUP_ID.trim().toUpperCase()
                    def sqlLines = []
                    def changed  = false

                    wsList.each { ws ->
                        withCredentials([string(credentialsId: ws.credential_id, variable: 'DB_TOKEN')]) {
                            def catalog = ws.catalog ?: 'demo_catalog'
                            def wh = readJSON text: sh(returnStdout:true, script:"curl -s '${ws.workspace_url}/api/2.0/sql/warehouses' -H 'Authorization: Bearer ${DB_TOKEN}'").trim()
                            if ((wh.warehouses ?: []).isEmpty()) { echo "  ${ws.name}: no warehouse"; return }
                            def whId = wh.warehouses[0].id

                            def runQ = { String sql ->
                                def p   = writeJSON(returnText:true, json:[statement:sql, warehouse_id:whId, wait_timeout:'50s', on_wait_timeout:'CANCEL'])
                                def tmp = "/tmp/sq_${System.currentTimeMillis()}.json"
                                writeFile file:tmp, text:p
                                def raw = sh(returnStdout:true, script:"curl -s -w \"\\n%{http_code}\" -X POST '${ws.workspace_url}/api/2.0/sql/statements' -H 'Authorization: Bearer ${DB_TOKEN}' -H 'Content-Type: application/json' -d @${tmp}").trim()
                                sh "rm -f ${tmp}"
                                def lines = raw.split('\n')
                                if (lines[-1] != '200') return []
                                def j = readJSON text: lines[0..-2].join('\n')
                                return j.result?.data_array ?: []
                            }

                            def hdr = runQ("SELECT DATA_FLOW_GROUP_ID, TRIGGER_TYPE, ETL_LAYER FROM ${catalog}.admin.data_flow_control_header WHERE DATA_FLOW_GROUP_ID='${groupId}' AND IS_ACTIVE='Y'")
                            if (hdr.isEmpty()) { echo "  ${ws.name}: no header for ${groupId}"; return }

                            def det = runQ("SELECT SOURCE, SOURCE_OBJ_NAME, INPUT_FILE_FORMAT, STORAGE_TYPE, LOAD_TYPE FROM ${catalog}.admin.data_flow_l0_detail WHERE DATA_FLOW_GROUP_ID='${groupId}' AND IS_ACTIVE='Y'")
                            if (det.isEmpty()) { echo "  ${ws.name}: no detail rows"; return }

                            def triggerType = hdr[0][1]
                            def etlLayer = hdr[0][2]
                            sqlLines << "-- ${ws.name} | ${groupId} | ${env.BUNDLE_INFO}"
                            sqlLines << ""
                            sqlLines << "MERGE INTO ${catalog}.admin.data_flow_control_header AS tgt"
                            sqlLines << "USING (SELECT '${groupId}' AS DATA_FLOW_GROUP_ID,'${triggerType}' AS TRIGGER_TYPE,'${etlLayer}' AS ETL_LAYER,'Y' AS IS_ACTIVE,current_timestamp() AS INSERTED_TS,current_timestamp() AS UPDATED_TS) AS src"
                            sqlLines << "ON tgt.DATA_FLOW_GROUP_ID=src.DATA_FLOW_GROUP_ID AND tgt.ETL_LAYER=src.ETL_LAYER"
                            sqlLines << "WHEN MATCHED THEN UPDATE SET tgt.TRIGGER_TYPE=src.TRIGGER_TYPE,tgt.IS_ACTIVE=src.IS_ACTIVE,tgt.UPDATED_TS=src.UPDATED_TS"
                            sqlLines << "WHEN NOT MATCHED THEN INSERT *;"
                            sqlLines << ""
                            det.each { r ->
                                sqlLines << "MERGE INTO ${catalog}.admin.data_flow_l0_detail AS tgt"
                                sqlLines << "USING (SELECT '${groupId}' AS DATA_FLOW_GROUP_ID,'${r[0]}' AS SOURCE,'${r[1]}' AS SOURCE_OBJ_NAME,'${r[2]}' AS INPUT_FILE_FORMAT,'${r[3]}' AS STORAGE_TYPE,'${r[4]}' AS LOAD_TYPE,'Y' AS IS_ACTIVE,current_timestamp() AS INSERTED_TS,current_timestamp() AS UPDATED_TS) AS src"
                                sqlLines << "ON tgt.DATA_FLOW_GROUP_ID=src.DATA_FLOW_GROUP_ID AND tgt.SOURCE_OBJ_NAME=src.SOURCE_OBJ_NAME"
                                sqlLines << "WHEN MATCHED THEN UPDATE SET tgt.SOURCE=src.SOURCE,tgt.INPUT_FILE_FORMAT=src.INPUT_FILE_FORMAT,tgt.STORAGE_TYPE=src.STORAGE_TYPE,tgt.LOAD_TYPE=src.LOAD_TYPE,tgt.IS_ACTIVE=src.IS_ACTIVE,tgt.UPDATED_TS=src.UPDATED_TS"
                                sqlLines << "WHEN NOT MATCHED THEN INSERT *;"
                                sqlLines << ""
                            }
                            changed = true
                            echo "  ${ws.name}: ${det.size()} rows collected"
                        }
                    }

                    if (!changed) { echo "Nothing to push"; return }

                    def sqlFile = "${env.SQL_SCRIPTS_FOLDER}/${groupId}.sql"
                    def sqlTmp  = "/tmp/${groupId}.txt"
                    writeFile file: sqlTmp, text: sqlLines.join('\n')
                    def b64 = sh(returnStdout:true, script:"base64 -w 0 ${sqlTmp}").trim()
                    sh "rm -f ${sqlTmp}"

                    withCredentials([string(credentialsId: env.GITHUB_CREDENTIAL_ID, variable: 'GH_TOKEN')]) {
                        def chk = sh(returnStdout:true, script:"curl -s -w \"\\n%{http_code}\" -X GET '${env.GITHUB_API}/repos/${env.GITHUB_OWNER}/${env.GITHUB_REPO_NAME}/contents/${sqlFile}?ref=${env.GITHUB_BRANCH}' -H 'Authorization: Bearer ${GH_TOKEN}'").trim()
                        def chkLines = chk.split('\n')
                        def payload  = [message:"sync: ${groupId}.sql ${env.BUNDLE_INFO} [Jenkins]", content:b64, branch:env.GITHUB_BRANCH]
                        if (chkLines[-1] == '200') {
                            def sha = readJSON(text: chkLines[0..-2].join('\n')).sha
                            payload.sha = sha
                        }
                        def pTmp = "/tmp/ghpush_${System.currentTimeMillis()}.json"
                        writeFile file: pTmp, text: writeJSON(returnText:true, json:payload)
                        def code = sh(returnStdout:true, script:"curl -s -w \"\\n%{http_code}\" -X PUT '${env.GITHUB_API}/repos/${env.GITHUB_OWNER}/${env.GITHUB_REPO_NAME}/contents/${sqlFile}' -H 'Authorization: Bearer ${GH_TOKEN}' -H 'Content-Type: application/json' -d @${pTmp}").trim().split('\n')[-1]
                        sh "rm -f ${pTmp}"
                        echo code in ['200','201'] ? "✅ ${sqlFile} pushed" : "❌ push HTTP ${code}"
                    }
                }
            }
        }

        // ── STAGE 5a : QUERY CONTROL TABLE (TRIGGER_TYPE) ────
        stage('Load Trigger Type') {
            when { expression { params.CREATE_JOBS } }
            steps {
                script {
                    def wsList  = readJSON text: env.SELECTED_WORKSPACES
                    def groupId = params.GROUP_ID.trim().toUpperCase()
                    def triggerMap = [:]   // wsName → TRIGGER_TYPE (JOB or DLT)

                    wsList.each { ws ->
                        withCredentials([string(credentialsId: ws.credential_id, variable: 'DB_TOKEN')]) {
                            def catalog = ws.catalog ?: 'demo_catalog'
                            def wh = readJSON text: sh(returnStdout:true, script:"curl -s '${ws.workspace_url}/api/2.0/sql/warehouses' -H 'Authorization: Bearer ${DB_TOKEN}'").trim()
                            if ((wh.warehouses ?: []).isEmpty()) { 
                                echo "  ${ws.name}: no warehouse (default to JOB)"
                                triggerMap[ws.name] = 'JOB'
                                return 
                            }
                            def whId = wh.warehouses[0].id

                            def sql = "SELECT TRIGGER_TYPE FROM ${catalog}.admin.data_flow_control_header WHERE DATA_FLOW_GROUP_ID='${groupId}' AND IS_ACTIVE='Y' LIMIT 1"
                            def p = writeJSON(returnText:true, json:[statement:sql, warehouse_id:whId, wait_timeout:'50s', on_wait_timeout:'CANCEL'])
                            def tmp = "/tmp/ttype_${System.currentTimeMillis()}.json"
                            writeFile file: tmp, text: p
                            def raw = sh(returnStdout:true, script:"curl -s -w \"\\n%{http_code}\" -X POST '${ws.workspace_url}/api/2.0/sql/statements' -H 'Authorization: Bearer ${DB_TOKEN}' -H 'Content-Type: application/json' -d @${tmp}").trim()
                            sh "rm -f ${tmp}"
                            def lines = raw.split('\n')
                            def triggerType = 'JOB'  // default
                            if (lines[-1] == '200') {
                                def j = readJSON text: lines[0..-2].join('\n')
                                def rows = j.result?.data_array ?: []
                                if (!rows.isEmpty()) {
                                    triggerType = (rows[0][0] ?: 'JOB').toUpperCase().trim()
                                }
                            }
                            triggerMap[ws.name] = triggerType
                            echo "  ${ws.name}: TRIGGER_TYPE = ${triggerType}"
                        }
                    }
                    env.TRIGGER_MAP = writeJSON(returnText:true, json:triggerMap)
                }
            }
        }

        // ── STAGE 5b : QUERY TABLE CONFIG ───────────────────
        stage('Load Table Config') {
            when { expression { params.CREATE_JOBS } }
            steps {
                script {
                    def wsList  = readJSON text: env.SELECTED_WORKSPACES
                    def groupId = params.GROUP_ID.trim().toUpperCase()
                    def layer   = env.DETECTED_LAYER
                    def tableMap = [:]   // wsName → list of [TARGET_TABLE, TARGET_SCHEMA]

                    wsList.each { ws ->
                        withCredentials([string(credentialsId: ws.credential_id, variable: 'DB_TOKEN')]) {
                            def catalog = ws.catalog ?: 'demo_catalog'
                            def wh = readJSON text: sh(returnStdout:true, script:"curl -s '${ws.workspace_url}/api/2.0/sql/warehouses' -H 'Authorization: Bearer ${DB_TOKEN}'").trim()
                            if ((wh.warehouses ?: []).isEmpty()) { echo "  ${ws.name}: no warehouse"; tableMap[ws.name] = []; return }
                            def whId = wh.warehouses[0].id

                            def detail = (layer == 'L1' || layer == 'L2') ? 'data_flow_pb_detail' : 'data_flow_l0_detail'
                            def sql    = (layer == 'L0') 
                                ? "SELECT SOURCE_OBJ_NAME, SOURCE_OBJ_SCHEMA, COALESCE(PRIORITY, 999) AS PRIORITY FROM ${catalog}.admin.${detail} WHERE DATA_FLOW_GROUP_ID='${groupId}' AND IS_ACTIVE='Y' ORDER BY PRIORITY, SOURCE_OBJ_NAME"
                                : "SELECT TARGET_OBJ_NAME, TARGET_OBJ_SCHEMA, COALESCE(PRIORITY, 999) AS PRIORITY FROM ${catalog}.admin.${detail} WHERE DATA_FLOW_GROUP_ID='${groupId}' AND IS_ACTIVE='Y' AND UPPER(TARGET_OBJ_TYPE)!='VIEW' ORDER BY PRIORITY, TARGET_OBJ_NAME"
                            def p      = writeJSON(returnText:true, json:[statement:sql, warehouse_id:whId, wait_timeout:'50s', on_wait_timeout:'CANCEL'])
                            def tmp    = "/tmp/tbl_${System.currentTimeMillis()}.json"
                            writeFile file: tmp, text: p
                            def raw  = sh(returnStdout:true, script:"curl -s -w \"\\n%{http_code}\" -X POST '${ws.workspace_url}/api/2.0/sql/statements' -H 'Authorization: Bearer ${DB_TOKEN}' -H 'Content-Type: application/json' -d @${tmp}").trim()
                            sh "rm -f ${tmp}"
                            def lines = raw.split('\n')
                            def rowBody = lines[0..-2].join('\n')
                            def rowJson = lines[-1] == '200' ? readJSON(text: rowBody) : [:]
                            def rows    = rowJson.result?.data_array ?: []
                            tableMap[ws.name] = rows
                            echo "  ${ws.name}: ${rows.size()} object(s) in ${detail}"
                            rows.each { r -> echo "    → ${r[1] ?: 'stage'}.${r[0]} (priority=${r[2]})" }
                        }
                    }
                    env.TABLE_MAP = writeJSON(returnText:true, json:tableMap)
                }
            }
        }

        // ── STAGE 5c : CREATE JOBS / DLT PIPELINES ──────────
        stage('Create Jobs/Pipelines') {
            when { expression { params.CREATE_JOBS } }
            steps {
                script {
                    def wsList      = readJSON text: env.SELECTED_WORKSPACES
                    def triggerMap  = readJSON text: env.TRIGGER_MAP
                    def tableMap    = readJSON text: env.TABLE_MAP
                    def groupId     = params.GROUP_ID.trim().toUpperCase()
                    def tag         = params.BUNDLE_TAG?.trim() ?: 'untagged'
                    def parallelMap = [:]

                    wsList.each { ws ->
                        def wsLocal = ws
                        def triggerType = triggerMap[wsLocal.name] ?: 'JOB'
                        parallelMap[wsLocal.name] = {
                            withCredentials([string(credentialsId: wsLocal.credential_id, variable: 'DB_TOKEN')]) {
                                def catalog = wsLocal.catalog ?: 'demo_catalog'
                                def namePrefix = "DBX_${groupId}"
                                def nbPath     = env.DETECTED_LAYER == 'L0' ? "${wsLocal.github_repo_path}/notebooks/L0_DATA_INGESTION" : "${wsLocal.github_repo_path}/notebooks/L1_TRANSFORMATION"
                                def tableRows  = tableMap[wsLocal.name] ?: []

                                if (triggerType == 'DLT') {
                                    // ═══ CREATE DLT PIPELINE ═══
                                    def pipelineName = "${namePrefix}_DLT_PIPELINE"
                                    def listJson   = readJSON text: sh(returnStdout:true, script:"curl -s '${wsLocal.workspace_url}/api/2.1/pipelines?max_results=100' -H 'Authorization: Bearer ${DB_TOKEN}'").trim()
                                    def existing   = listJson.pipelines?.find { it.name == pipelineName }

                                    if (existing) {
                                        wsLocal.pipeline_id = existing.pipeline_id
                                        echo "  ${pipelineName} ✅ exists | id=${wsLocal.pipeline_id}"
                                    } else {
                                        def dltConfig = [
                                            name: pipelineName,
                                            storage: "/Volumes/${catalog}/bronze/dlt_storage",
                                            catalog: catalog,
                                            target: "silver",
                                            channel: "PREVIEW",
                                            edition: "PRO",
                                            photon: true,
                                            continuous: true,
                                            development: false,
                                            configurations: [GROUP_ID: groupId, ENVIRONMENT: tag],
                                            clusters: [[num_workers: 1, node_type_id: "i3.xlarge"]],
                                            libraries: [[notebook: [path: nbPath]]]
                                        ]
                                        def dp  = writeJSON(returnText:true, json:dltConfig)
                                        def df  = "/tmp/dlt_${System.currentTimeMillis()}.json"
                                        writeFile file: df, text: dp
                                        def raw = sh(returnStdout:true, script:"curl -s -w \"\\n%{http_code}\" -X POST '${wsLocal.workspace_url}/api/2.1/pipelines' -H 'Authorization: Bearer ${DB_TOKEN}' -H 'Content-Type: application/json' -d @${df}").trim()
                                        sh "rm -f ${df}"
                                        def lines = raw.split('\n')
                                        if (lines[-1] != '200') error "DLT create failed HTTP ${lines[-1]}: ${lines[0..-2].join('\n')}"
                                        def cjson = readJSON text: lines[0..-2].join('\n')
                                        wsLocal.pipeline_id = cjson.pipeline_id
                                        echo "  ${pipelineName} created | pipeline_id=${wsLocal.pipeline_id}"
                                    }
                                } else {
                                    // ═══ CREATE REGULAR JOB ═══
                                    def jobName    = "${namePrefix}_JOB"
                                    def expTasks   = tableRows.isEmpty() ? 1 : tableRows.size()

                                    // Check existing job
                                    def listJson   = readJSON text: sh(returnStdout:true, script:"curl -s '${wsLocal.workspace_url}/api/2.1/jobs/list?limit=100' -H 'Authorization: Bearer ${DB_TOKEN}'").trim()
                                    def existing   = listJson.jobs?.find { it.settings?.name == jobName }

                                    if (existing) {
                                        def curTasks = existing.settings?.tasks?.size() ?: 1
                                        if (curTasks == expTasks) {
                                            wsLocal.job_id = existing.job_id
                                            echo "  ${jobName} ✅ exists | tasks=${curTasks}"
                                        } else {
                                            // Delete stale job
                                            def dt = writeJSON(returnText:true, json:[job_id: existing.job_id])
                                            def df = "/tmp/del_${System.currentTimeMillis()}.json"
                                            writeFile file: df, text: dt
                                            sh "curl -s -X POST '${wsLocal.workspace_url}/api/2.1/jobs/delete' -H 'Authorization: Bearer ${DB_TOKEN}' -H 'Content-Type: application/json' -d @${df}"
                                            sh "rm -f ${df}"
                                            echo "  ${jobName} outdated (${curTasks}→${expTasks} tasks) — deleted"
                                            existing = null
                                        }
                                    }

                                    if (!existing) {
                                        // Build tasks list with PRIORITY-based dependencies
                                        def tasks = []
                                        if (tableRows.isEmpty()) {
                                            tasks = [[task_key:"${groupId}_task", notebook_task:[notebook_path:nbPath, base_parameters:[GROUP_ID:groupId, TARGET_LOAD_TABLE:'ALL', ENVIRONMENT:tag], source:'WORKSPACE']]]
                                        } else {
                                            // Group tables by priority
                                            def priorityGroups = [:]
                                            tableRows.each { r ->
                                                def priority = r[2] ?: 999
                                                if (!priorityGroups[priority]) priorityGroups[priority] = []
                                                priorityGroups[priority] << r
                                            }
                                            
                                            // Build tasks with dependencies on previous priority group
                                            def prevPriorityTasks = []
                                            priorityGroups.sort().each { priority, tables ->
                                                tables.each { r ->
                                                    def tbl = r[0]
                                                    def task = [
                                                        task_key: tbl.replaceAll('[^a-zA-Z0-9_]','_'),
                                                        notebook_task: [
                                                            notebook_path: nbPath,
                                                            base_parameters: [GROUP_ID:groupId, TARGET_LOAD_TABLE:tbl, ENVIRONMENT:tag],
                                                            source: 'WORKSPACE'
                                                        ]
                                                    ]
                                                    
                                                    // Add dependency on ALL tasks from previous priority
                                                    if (!prevPriorityTasks.isEmpty()) {
                                                        task.depends_on = prevPriorityTasks.collect { [task_key: it] }
                                                    }
                                                    
                                                    tasks << task
                                                }
                                                
                                                // Save current priority tasks for next iteration
                                                prevPriorityTasks = tables.collect { it[0].replaceAll('[^a-zA-Z0-9_]','_') }
                                            }
                                        }

                                        def jp  = writeJSON(returnText:true, json:[
                                            name:jobName, description:"GROUP_ID:${groupId}|Layer:${env.DETECTED_LAYER}|Bundle:${tag}|${env.DEPLOY_TS}",
                                            max_concurrent_runs:1,
                                            parameters:[[name:'GROUP_ID',default:groupId],[name:'ENVIRONMENT',default:tag]],
                                            tasks:tasks
                                        ])
                                        def jf  = "/tmp/job_${System.currentTimeMillis()}.json"
                                        writeFile file:jf, text:jp
                                        def raw = sh(returnStdout:true, script:"curl -s -w \"\\n%{http_code}\" -X POST '${wsLocal.workspace_url}/api/2.1/jobs/create' -H 'Authorization: Bearer ${DB_TOKEN}' -H 'Content-Type: application/json' -d @${jf}").trim()
                                        sh "rm -f ${jf}"
                                        def lines = raw.split('\n')
                                        if (lines[-1] != '200') error "Job create failed HTTP ${lines[-1]}: ${lines[0..-2].join('\n')}"
                                        def cjson = readJSON text: lines[0..-2].join('\n')
                                        wsLocal.job_id = cjson.job_id
                                        echo "  ${jobName} created | job_id=${wsLocal.job_id} | tasks=${tasks.size()}"
                                        tasks.each { t -> 
                                            def deps = t.depends_on ? "[deps: ${t.depends_on.collect{it.task_key}.join(',')}]" : "[no deps]"
                                            echo "    task: ${t.task_key} → ${t.notebook_task.base_parameters.TARGET_LOAD_TABLE ?: '(all)'} ${deps}" 
                                        }
                                    }
                                }
                            }
                        }
                    }
                    parallel parallelMap
                    env.SELECTED_WORKSPACES = writeJSON(returnText:true, json:wsList)
                }
            }
        }

        // ── STAGE 6 : TRIGGER ───────────────────────────────
        stage('Trigger Jobs/Pipelines') {
            steps {
                script {
                    def wsList  = readJSON text: env.SELECTED_WORKSPACES
                    def triggerMap = readJSON text: env.TRIGGER_MAP
                    def groupId = params.GROUP_ID.trim().toUpperCase()
                    def runIds  = [:]
                    def pMap    = [:]

                    wsList.each { ws ->
                        def triggerType = triggerMap[ws.name] ?: 'JOB'
                        pMap[ws.name] = {
                            withCredentials([string(credentialsId: ws.credential_id, variable: 'DB_TOKEN')]) {
                                if (triggerType == 'DLT') {
                                    // TRIGGER DLT PIPELINE
                                    def pipelineId = ws.pipeline_id
                                    def raw = sh(returnStdout:true, script:"curl -s -w \"\\n%{http_code}\" -X POST '${ws.workspace_url}/api/2.1/pipelines/${pipelineId}/updates' -H 'Authorization: Bearer ${DB_TOKEN}' -H 'Content-Type: application/json' -d '{}'").trim()
                                    def lines = raw.split('\n')
                                    if (lines[-1] != '200') error "DLT trigger failed HTTP ${lines[-1]}: ${lines[0..-2].join('\n')}"
                                    def rjson = readJSON text: lines[0..-2].join('\n')
                                    def updateId = rjson.update_id
                                    runIds[ws.name] = [update_id:updateId, pipeline_id:pipelineId, workspace_url:ws.workspace_url, credential_id:ws.credential_id, is_dlt:true]
                                    echo "  ${ws.name} DLT triggered | update_id=${updateId}"
                                } else {
                                    // TRIGGER REGULAR JOB
                                    def tp  = writeJSON(returnText:true, json:[job_id:ws.job_id, job_parameters:[GROUP_ID:groupId, RUN_LAYER:env.DETECTED_LAYER]])
                                    def tf  = "/tmp/trig_${System.currentTimeMillis()}.json"
                                    writeFile file:tf, text:tp
                                    def raw = sh(returnStdout:true, script:"curl -s -w \"\\n%{http_code}\" -X POST '${ws.workspace_url}/api/2.1/jobs/run-now' -H 'Authorization: Bearer ${DB_TOKEN}' -H 'Content-Type: application/json' -d @${tf}").trim()
                                    sh "rm -f ${tf}"
                                    def lines = raw.split('\n')
                                    if (lines[-1] != '200') error "Trigger failed HTTP ${lines[-1]}: ${lines[0..-2].join('\n')}"
                                    def rjson = readJSON text: lines[0..-2].join('\n')
                                    def runId = rjson.run_id
                                    runIds[ws.name] = [run_id:runId, workspace_url:ws.workspace_url, credential_id:ws.credential_id, is_dlt:false]
                                    echo "  ${ws.name} Job triggered | run_id=${runId}"
                                }
                            }
                        }
                    }
                    parallel pMap
                    env.RUN_IDS = writeJSON(returnText:true, json:runIds)
                }
            }
        }

        // ── STAGE 7 : WAIT ──────────────────────────────────
        stage('Wait For Completion') {
            when { expression { params.WAIT_FOR_COMPLETION } }
            steps {
                script {
                    def runIds     = readJSON text: env.RUN_IDS
                    def allPassed  = true
                    def failedList = []

                    runIds.each { wsName, info ->
                        withCredentials([string(credentialsId: info.credential_id, variable: 'DB_TOKEN')]) {
                            if (info.is_dlt) {
                                // WAIT FOR DLT UPDATE
                                def elapsed = 0
                                def done    = false
                                def lc = ''; def rs = ''
                                while (!done && elapsed < Integer.parseInt(env.MAX_WAIT_SECS)) {
                                    sleep(Integer.parseInt(env.POLL_INTERVAL))
                                    elapsed += Integer.parseInt(env.POLL_INTERVAL)
                                    def p    = readJSON text: sh(returnStdout:true, script:"curl -s '${info.workspace_url}/api/2.1/pipelines/${info.pipeline_id}/updates/${info.update_id}' -H 'Authorization: Bearer ${DB_TOKEN}'").trim()
                                    lc       = p.update?.state ?: 'UNKNOWN'
                                    rs       = p.update?.state ?: ''
                                    echo "${wsName} DLT | ${lc}"
                                    if (['COMPLETED','FAILED','STOPPED'].contains(lc)) done = true
                                }
                                if (!done)        { failedList << "${wsName}(TIMEOUT)"; allPassed = false }
                                else if (lc != 'COMPLETED') { failedList << "${wsName}(${lc})"; allPassed = false }
                                else echo "${wsName} DLT — SUCCESS"
                            } else {
                                // WAIT FOR JOB
                                def elapsed = 0
                                def done    = false
                                def lc = ''; def rs = ''
                                while (!done && elapsed < Integer.parseInt(env.MAX_WAIT_SECS)) {
                                    sleep(Integer.parseInt(env.POLL_INTERVAL))
                                    elapsed += Integer.parseInt(env.POLL_INTERVAL)
                                    def p    = readJSON text: sh(returnStdout:true, script:"curl -s '${info.workspace_url}/api/2.1/jobs/runs/get?run_id=${info.run_id}' -H 'Authorization: Bearer ${DB_TOKEN}'").trim()
                                    lc       = p.state?.life_cycle_state ?: 'UNKNOWN'
                                    rs       = p.state?.result_state     ?: ''
                                    echo "${wsName} Job | ${lc} | ${rs}"
                                    if (['TERMINATED','SKIPPED','INTERNAL_ERROR'].contains(lc)) done = true
                                }
                                if (!done)        { failedList << "${wsName}(TIMEOUT)"; allPassed = false }
                                else if (rs != 'SUCCESS') { failedList << "${wsName}(${rs})"; allPassed = false }
                                else echo "${wsName} Job — SUCCESS"
                            }
                        }
                    }
                    if (!allPassed) error "Failed: ${failedList.join(', ')}"
                    echo "All workspaces complete"
                }
            }
        }

        // ── STAGE 8 : FINAL SUMMARY ─────────────────────────
        stage('Final Summary') {
            when { expression { params.WAIT_FOR_COMPLETION } }
            steps {
                script {
                    def wsList = readJSON text: env.SELECTED_WORKSPACES
                    def triggerMap = readJSON text: env.TRIGGER_MAP
                    echo "✅ Pipeline execution complete for all workspaces"
                    echo "Layer: ${env.DETECTED_LAYER} | Trigger types:"
                    wsList.each { ws -> 
                        def ttype = triggerMap[ws.name] ?: 'JOB'
                        echo "  → ${ws.name} (${ttype})" 
                    }
                }
            }
        }
    }

    post {
        always { echo "GROUP_ID:${params.GROUP_ID} | LAYER:${env.DETECTED_LAYER} | STATUS:${currentBuild.currentResult}" }
        success { echo "✅ PIPELINE SUCCESS" }
        failure { echo "❌ PIPELINE FAILED"  }
    }
}
